---
const { target, accept } = Astro.props;
---
<div id="cvPage" class="tool-grid" data-target={target}>
  <div class="card">
    <h2>Convert your image</h2>
    <label id="cvDrop" class="dropzone">
      <input id="cvFile" type="file" accept={accept} hidden />
      <strong>Click or drop your image here</strong>
      <span class="muted">Converted on your device. Nothing is uploaded.</span>
    </label>
    <div class="meta-list">
      <div class="meta-item"><span>File size</span><strong id="cvFileSize">—</strong></div>
      <div class="meta-item"><span>Dimensions</span><strong id="cvOrig">—</strong></div>
    </div>
    <div class="two-col">
      <div class="field"><label class="label" for="cvFormat">Convert to</label>
        <select id="cvFormat"><option value="image/png">PNG</option><option value="image/jpeg">JPEG</option><option value="image/webp">WebP</option></select></div>
      <div class="field"><label class="label" for="cvQuality">Quality <span id="cvQualityValue">0.92</span></label>
        <input id="cvQuality" type="range" min="0.1" max="1" step="0.01" value="0.92" /></div>
    </div>
    <button id="cvButton" class="btn" type="button">Convert image</button>
  </div>
  <div class="card">
    <h2>Result</h2>
    <div id="cvPreview" class="preview"><div class="muted">Upload an image to preview.</div></div>
    <div id="cvResult" class="hidden">
      <div class="meta-list"><div class="meta-item"><span>Result</span><strong id="cvResultSize">—</strong></div></div>
      <div class="actions"><a id="cvDownload" class="btn" download>Download converted image</a></div>
    </div>
  </div>
</div>
