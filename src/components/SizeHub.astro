---
import { PLATFORMS } from "../data/hub.js";
import Icon from "./Icon.astro";
---

<section class="size-hub" id="size-tools" aria-labelledby="size-hub-h">
  <h2 id="size-hub-h">Size tools by platform</h2>
  <p class="size-hub-intro">
    Pick a platform, then an image type. Each one opens a free tool that
    resizes and crops your image for you.
  </p>
  <div class="hub">
    {
      PLATFORMS.map((p) => (
        <section class={`hub-group span-${Math.min(4, p.cards.length)}`} aria-labelledby={`h-${p.name}`}>
          <div class="hub-head">
            <span class="hub-badge" aria-hidden="true"><Icon name={p.icon} size={28} /></span>
            <h3 id={`h-${p.name}`}>{p.name}</h3>
          </div>
          <div class="hub-grid">
            {p.cards.map((c) => (
              <a class="tool-card" href={c.href}>
                <h4>{c.name}</h4>
                <p class="tc-size">
                  {c.sizes.map((s) => (
                    <span>{s}</span>
                  ))}
                </p>
                <p class="tc-does">
                  {c.does} <b aria-hidden="true">→</b>
                </p>
              </a>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</section>

<style>
  .size-hub { max-width: 1040px; margin: 56px auto 0; scroll-margin-top: 90px; }
  .size-hub > h2 { font-size: 1.5rem; letter-spacing: -.02em; margin: 0 0 4px; }
  .size-hub-intro { margin: 0; color: var(--muted); font-size: 15px; }
  .hub { max-width: none; margin-top: 20px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-flow: row dense; gap: 22px 14px; align-items: start; }
  .hub-group { min-width: 0; }
  .span-1 { grid-column: span 1; } .span-2 { grid-column: span 2; } .span-3 { grid-column: span 3; } .span-4 { grid-column: span 4; }
  .hub-head { margin-bottom: 10px; gap: 10px; }
  .hub-head h3 { margin: 0; font-size: 1.1rem; letter-spacing: -.02em; }
  .hub-grid { gap: 12px; grid-template-columns: repeat(1, minmax(0, 1fr)); }
  .span-2 .hub-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .span-3 .hub-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .span-4 .hub-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .tool-card { padding: 16px; }
  .tool-card h4 { margin: 0 0 8px; font-size: 1.02rem; color: var(--text); }
  .tc-does { margin: 0; }
  .tc-does b { display: inline-block; color: var(--violet-text); font-weight: 700; transition: transform .15s; }
  .tool-card:hover .tc-does b, .tool-card:focus-visible .tc-does b { transform: translateX(4px); }
  @media (max-width: 900px) {
    .hub { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .span-3, .span-4 { grid-column: span 2; }
    .span-3 .hub-grid, .span-4 .hub-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) {
    .hub { grid-template-columns: minmax(0, 1fr); }
    .span-2, .span-3, .span-4 { grid-column: span 1; }
    .span-2 .hub-grid, .span-3 .hub-grid, .span-4 .hub-grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
