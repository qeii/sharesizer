---
// Find & replace (Ctrl+H style), space clean-up and add text in front/back. Text never leaves the browser.
---
<section class="fr">
  <div class="card fr-main">
    <div class="fr-bar">
      <h2>Your text</h2>
      <div class="fr-stats" id="frStats" aria-live="off">0 characters · 0 words · 0 lines</div>
    </div>
    <label class="sr-only" for="frText">Text to edit</label>
    <textarea id="frText" spellcheck="false" placeholder="Paste or type your text here…"></textarea>
    <div class="fr-tools">
      <button type="button" class="btn secondary" id="frUndo" disabled>Undo</button>
      <button type="button" class="btn secondary" id="frCopy">Copy text</button>
      <button type="button" class="btn secondary" id="frClear">Clear</button>
      <span class="fr-status" id="frStatus" role="status" aria-live="polite"></span>
    </div>
  </div>

  <div class="fr-panels">
    <div class="card">
      <h2>Find and replace</h2>
      <div class="field"><label class="label" for="frFind">Find what</label><input id="frFind" type="text" autocomplete="off" spellcheck="false" /></div>
      <div class="field"><label class="label" for="frRepl">Replace with</label><input id="frRepl" type="text" autocomplete="off" spellcheck="false" /></div>
      <div class="fr-opts">
        <label><input type="checkbox" id="frCase" /> Match case</label>
        <label><input type="checkbox" id="frWord" /> Whole word</label>
        <label><input type="checkbox" id="frRegex" /> Use regular expression</label>
      </div>
      <p class="fr-count" id="frCount" aria-live="polite"></p>
      <div class="fr-btns">
        <button type="button" class="btn secondary" id="frNext">Find next</button>
        <button type="button" class="btn secondary" id="frOne">Replace</button>
        <button type="button" class="btn" id="frAll">Replace all</button>
      </div>
      <p class="fr-hint">In regular expression mode, ^ and $ match each line, and \n and \t in Replace with mean a new line and a tab.</p>
    </div>

    <div class="card">
      <h2>Remove spaces</h2>
      <p class="muted fr-sub">Line breaks are kept.</p>
      <div class="fr-stack">
        <button type="button" class="btn secondary" data-clean="all">Remove all spaces</button>
        <button type="button" class="btn secondary" data-clean="collapse">Collapse extra spaces</button>
        <button type="button" class="btn secondary" data-clean="trim">Trim line edges</button>
        <button type="button" class="btn secondary" data-clean="blank">Remove blank lines</button>
      </div>
    </div>

    <div class="card">
      <h2>Add a word in front or back</h2>
      <div class="field"><label class="label" for="frFront">Add in front</label><input id="frFront" type="text" autocomplete="off" spellcheck="false" placeholder="e.g. - or “Hello " /></div>
      <div class="field"><label class="label" for="frBack">Add at the end</label><input id="frBack" type="text" autocomplete="off" spellcheck="false" placeholder="e.g. ; or .com" /></div>
      <div class="field"><label class="label" for="frScope">Add it to</label>
        <select id="frScope"><option value="lines">Every line</option><option value="words">Every word</option><option value="text">Whole text (once)</option></select></div>
      <div class="fr-opts"><label><input type="checkbox" id="frSkip" checked /> Skip empty lines</label></div>
      <button type="button" class="btn" id="frAdd">Add to text</button>
    </div>
  </div>
</section>

<style>
  .fr { display: grid; gap: 22px; }
  .fr-main { padding: 22px; }
  .fr-bar { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; margin-bottom: 10px; }
  .fr-bar h2, .fr-panels h2 { margin: 0; font-size: 1.1rem; }
  .fr-stats { font-size: 13px; color: var(--muted); font-variant-numeric: tabular-nums; }
  #frText { display: block; width: 100%; min-height: 300px; resize: vertical; font: 15px/1.6 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; color: var(--text); background: var(--surface2); border: 1px solid var(--border); border-radius: 14px; padding: 14px 16px; outline: none; }
  #frText:focus, .fr input[type="text"]:focus, .fr select:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(139,124,255,.18); }
  .fr-tools { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; margin-top: 12px; }
  .fr-tools .btn { width: auto; padding: 10px 18px; }
  .fr-tools .btn:disabled { opacity: .45; cursor: default; }
  .fr-status { font-size: 13.5px; color: var(--ok-text); margin-left: 4px; }
  .fr-status.bad { color: var(--bad-text); }
  .fr-panels { display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: 18px; align-items: start; }
  .fr-panels .card { padding: 22px; }
  .fr-panels h2 { margin-bottom: 14px; }
  .fr-sub { margin: -8px 0 14px; font-size: 13.5px; }
  .fr-opts { display: grid; gap: 8px; margin: 2px 0 14px; font-size: 14px; }
  .fr-opts label { display: flex; align-items: center; gap: 8px; cursor: pointer; }
  .fr-opts input { accent-color: var(--accent); width: 16px; height: 16px; }
  .fr-count { margin: 0 0 12px; font-size: 13.5px; color: var(--muted); min-height: 20px; }
  .fr-count.bad { color: var(--bad-text); }
  .fr-btns { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .fr-btns .btn { padding: 11px 6px; font-size: 14px; }
  .fr-stack { display: grid; gap: 10px; }
  .fr-hint { margin: 12px 0 0; font-size: 12.5px; color: var(--muted); }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
