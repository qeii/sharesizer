<section id="panel-cropper" class="panel">
  <div class="tool-grid">
    <div class="card">
      <h2>Image Cropper</h2>
      <p class="muted">Drag the box or use corner handles to crop.</p>

      <label id="crDrop" class="dropzone">
        <input id="crFile" type="file" accept="image/*" hidden />
        <strong>Click or drop image here</strong>
        <span class="muted">Crop output uses original resolution</span>
      </label>

      <div class="meta-list">
        <div class="meta-item"><span>Crop area</span><strong id="crInfo">—</strong></div>
      </div>

      <div class="two-col">
        <div class="field">
          <label class="label" for="crFormat">Format</label>
          <select id="crFormat">
            <option value="image/png">PNG</option>
            <option value="image/jpeg">JPEG</option>
            <option value="image/webp">WebP</option>
          </select>
        </div>
        <div class="field">
          <label class="label" for="crQuality">Quality <span id="crQualityValue">0.92</span></label>
          <input id="crQuality" type="range" min="0.1" max="1" step="0.01" value="0.92" />
        </div>
      </div>

      <button id="crButton" class="btn">Crop & download</button>

      <div class="notice">
        Drag the box to move it. Drag corners to resize. The exported crop uses the original image resolution.
      </div>
    </div>

    <div class="card">
      <h2>Crop Area</h2>

      <div id="crEmpty" class="preview">
        <div class="muted">Upload an image to start cropping.</div>
      </div>

      <div id="crStage" class="crop-stage hidden">
        <img id="crImage" alt="Image to crop" />
        <div id="crBox" class="crop-box" aria-label="Crop area">
          <div class="handle nw" data-handle="nw"></div>
          <div class="handle ne" data-handle="ne"></div>
          <div class="handle sw" data-handle="sw"></div>
          <div class="handle se" data-handle="se"></div>
        </div>
      </div>
    </div>
  </div>
</section>
