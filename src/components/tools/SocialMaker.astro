<section id="panel-social" class="panel">
  <div class="tool-grid">
    <div class="card">
      <h2>Image to Social Media</h2>
      <p class="muted">Create a platform-sized version from one upload.</p>

      <label id="smDrop" class="dropzone">
        <input id="smFile" type="file" accept="image/*" hidden />
        <strong>Click or drop image here</strong>
        <span class="muted">Recommended: high-resolution JPG/PNG</span>
      </label>

      <div class="meta-list">
        <div class="meta-item"><span>File size</span><strong id="smFileSize">—</strong></div>
        <div class="meta-item"><span>Original dimensions</span><strong id="smOrig">—</strong></div>
      </div>

      <div class="field">
        <label class="label" for="smPlatform">Platform size</label>
        <select id="smPlatform"></select>
      </div>

      <div class="two-col">
        <div class="field">
          <label class="label" for="smFit">Fit mode</label>
          <select id="smFit">
            <option value="cover">Cover / crop</option>
            <option value="contain">Contain / pad</option>
          </select>
        </div>
        <div class="field">
          <label class="label" for="smBackground">Padding background</label>
          <input id="smBackground" type="color" value="#ffffff" />
        </div>
      </div>

      <div class="two-col">
        <div class="field">
          <label class="label" for="smFormat">Format</label>
          <select id="smFormat">
            <option value="image/jpeg">JPEG</option>
            <option value="image/png">PNG</option>
            <option value="image/webp">WebP</option>
          </select>
        </div>
        <div class="field">
          <label class="label" for="smQuality">Quality <span id="smQualityValue">0.92</span></label>
          <input id="smQuality" type="range" min="0.1" max="1" step="0.01" value="0.92" />
        </div>
      </div>

      <button id="smButton" class="btn">Generate social image</button>

      <div class="notice">
        Cover crops to fill the full canvas. Contain fits the whole image and adds padding.
      </div>
    </div>

    <div class="card">
      <h2>Output</h2>
      <div id="smPreview" class="preview">
        <div class="muted">Upload an image and generate a preview.</div>
      </div>

      <div id="smResult" class="hidden">
        <div class="meta-list">
          <div class="meta-item"><span>Result</span><strong id="smResultSize">—</strong></div>
        </div>
        <div class="actions">
          <a id="smDownload" class="btn" download>Download social image</a>
        </div>
      </div>
    </div>
  </div>
  <p class="hint" style="margin-top:16px">Need every YouTube size at once? <a href="/youtube-image-sizes" style="color:var(--violet-text)">Open the YouTube image pack tool →</a></p>
</section>
