<section id="panel-compressor" class="panel">
  <div class="tool-grid">
    <div class="card">
      <h2>Image Compressor</h2>
      <p class="muted">Reduce file size for faster pages and ad-friendly assets.</p>

      <label id="cpDrop" class="dropzone">
        <input id="cpFile" type="file" accept="image/*" hidden />
        <strong>Click or drop image here</strong>
        <span class="muted">Best for JPG/WebP exports</span>
      </label>

      <div class="meta-list">
        <div class="meta-item"><span>File size</span><strong id="cpFileSize">—</strong></div>
        <div class="meta-item"><span>Dimensions</span><strong id="cpOrig">—</strong></div>
      </div>

      <div class="two-col">
        <div class="field">
          <label class="label" for="cpFormat">Format</label>
          <select id="cpFormat">
            <option value="image/jpeg">JPEG</option>
            <option value="image/webp">WebP</option>
            <option value="image/png">PNG</option>
          </select>
        </div>
        <div class="field">
          <label class="label" for="cpQuality">Quality <span id="cpQualityValue">0.8</span></label>
          <input id="cpQuality" type="range" min="0.1" max="1" step="0.01" value="0.8" />
        </div>
      </div>

      <button id="cpButton" class="btn">Compress image</button>

      <div class="notice">
        PNG is lossless in browser canvas, so quality may not reduce PNG size much.
        Use JPEG or WebP for photos.
      </div>
    </div>

    <div class="card">
      <h2>Output</h2>
      <div id="cpPreview" class="preview">
        <div class="muted">Upload an image to preview.</div>
      </div>

      <div id="cpResult" class="hidden">
        <div class="meta-list">
          <div class="meta-item"><span>New size</span><strong id="cpResultSize">—</strong></div>
          <div class="meta-item"><span>Savings</span><strong id="cpSavings">—</strong></div>
        </div>
        <div class="actions">
          <a id="cpDownload" class="btn" download>Download compressed image</a>
        </div>
      </div>
    </div>
  </div>
</section>
