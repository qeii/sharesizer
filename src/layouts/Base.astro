---
import '../styles/tools.css';
import '../styles/theme.css';
import '../styles/editor.css';
import '../styles/blog.css';
import '../styles/thumb.css';
import '../styles/hub.css';
import '../styles/ui.css';
const { title = 'Sharesizer — Free Image Tools for Creators', description = 'Resize, crop, compress, convert and check social media image sizes in your browser. Files never leave your device.', ld = [], wide = false } = Astro.props;
import { PROMO, promoUrl } from '../data/site.js';
---
<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:site_name" content="Sharesizer" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
  <meta name="twitter:card" content="summary" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  <script is:inline>
    (function(){try{var t=localStorage.getItem('theme')||'dark';document.documentElement.dataset.theme=t}catch(e){}})();
  </script>
</head>
<body>
  <!-- Shared gradient used by every <Icon>. userSpaceOnUse so straight lines in an icon still get colour. -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="ss-grad" gradientUnits="userSpaceOnUse" x1="3" y1="3" x2="21" y2="21">
        <stop offset="0" style="stop-color:var(--accent)" />
        <stop offset="1" style="stop-color:var(--accent-2)" />
      </linearGradient>
    </defs>
  </svg>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-head">
    <div class="wrap head-in">
      <a class="brand" href="/" aria-label="Sharesizer home">
        <span class="logo-mark">S</span>
        <span class="brand-tx"><strong>Sharesizer</strong><small>Image tools for creators</small></span>
      </a>
      <nav class="main-nav" aria-label="Main">
        <a href="/#tools">Tools</a><a href="/#size-tools">Social sizes</a><a href="/#converters">Converters</a><a href="/#guides">Guides</a><a href="/#faq">FAQ</a><a href="/blog">Blog</a>
      </nav>
      <div class="head-actions">
        <span class="pill-lock"><i aria-hidden="true"></i>Files stay in your browser</span>
        <button class="theme-toggle" id="themeToggle" type="button" aria-label="Switch light/dark theme">◐</button>
      </div>
    </div>
  </header>
  <main id="main" class={wide ? 'wide-main' : 'container'}><slot /></main>
  <footer class="site-foot">
    <div class="wrap">
      <div class="f-grid">
        <div>
          <a class="brand" href="/"><span class="logo-mark">S</span><span class="brand-tx"><strong>Sharesizer</strong><small>Image tools for creators</small></span></a>
          <p class="f-blurb">Free, private tools that run entirely in your browser. Resize, compress, convert and check sizes, without ever uploading a file.</p>
        </div>
        <div><h4>Popular tools</h4><ul>
          <li><a href="/resize-image">Image Resizer</a></li><li><a href="/compress-image">Image Compressor</a></li>
          <li><a href="/image-converter">Image Converter</a></li><li><a href="/photo-editor">Photo Editor</a></li>
          <li><a href="/qr-code-generator">QR Code Generator</a></li></ul></div>
        <div><h4>Platform sizes</h4><ul>
          <li><a href="/youtube-thumbnail-size">YouTube thumbnail</a></li><li><a href="/instagram-post-size">Instagram post</a></li>
          <li><a href="/tiktok-image-size">TikTok image</a></li><li><a href="/facebook-cover-photo-size">Facebook cover</a></li>
          <li><a href="/#size-tools">All platforms</a></li></ul></div>
        <div><h4>Company</h4><ul>
          <li><a href="/about">About</a></li><li><a href="/privacy">Privacy</a></li><li><a href="/contact">Contact</a></li>
          <li><a href="/blog">Blog</a></li><li><a href={promoUrl('footer')} target="_blank" rel="noopener">{PROMO.footer}</a></li></ul></div>
      </div>
      <div class="f-bottom">
        <span>© {new Date().getFullYear()} Sharesizer</span>
        <span>All processing happens locally in your browser. Social specs are recommendations and may change.</span>
      </div>
    </div>
  </footer>
  <script>
    document.getElementById('themeToggle')?.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch (e) {}
    });
  </script>
</body>
</html>
