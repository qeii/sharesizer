---
import Base from '../layouts/Base.astro';
import SizeTool from '../components/SizeTool.astro';
import { SIZE_PAGES, resolveVariants, UPDATED } from '../data/size-pages.js';
import { ratioLabel as ratio } from '../data/platforms.js';
export function getStaticPaths() { return SIZE_PAGES.map((page) => ({ params: { slug: page.slug }, props: { page } })); }
const p = Astro.props.page;
const variants = resolveVariants(p);
const rows = [
  ...variants.map((v) => [v.name, `${v.w} × ${v.h} px (${ratio(v.w, v.h)})`]),
  ...variants.map((v) => [`Sharesizer file-size target${variants.length > 1 ? ` (${v.name})` : ''}`, `under ${v.maxMB} MB`]),
  ...p.extra,
];
const related = p.related.map((s) => SIZE_PAGES.find((x) => x.slug === s)).filter(Boolean);
const url = new URL(Astro.url.pathname, Astro.site).href;
const ld = [
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: p.h1, url, applicationCategory: 'MultimediaApplication', operatingSystem: 'Any', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, description: p.description },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: p.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Sharesizer', item: new URL('/', Astro.site).href }, { '@type': 'ListItem', position: 2, name: 'Size tools', item: new URL('/size-tools', Astro.site).href }, { '@type': 'ListItem', position: 3, name: p.h1, item: url }] },
];
---
<Base title={p.title} description={p.description} ld={ld}>
  <section class="hero">
    <p class="crumb"><a href="/size-tools">Size tools</a> › {p.platform}</p>
    <h1>{p.h1}</h1>
    <p>{p.intro}</p>
  </section>

  <div style="margin-top:26px"><SizeTool variants={variants} /></div>
  <script>import '../scripts/size-tool.js';</script>

  <article class="prose">
    <h2>Dimensions and specs</h2>
    <table><tbody>{rows.map(([k, v]) => <tr><th>{k}</th><td>{v}</td></tr>)}</tbody></table>
    <p class="meta">Checked {UPDATED} against several current guides. Platforms change specs without notice, so confirm in the app before a big launch.</p>

    <h2>How to resize your image for {p.platform}</h2>
    <ol>
      <li>Upload your image above. It never leaves your device.</li>
      <li>Choose <strong>Cover</strong> to fill the frame by cropping, or <strong>Contain</strong> to keep the whole image with padding.</li>
      <li>In Cover mode, click or drag on the preview to choose which part to keep.</li>
      <li>Check the shaded guides, then download your image.</li>
    </ol>

    <h2>Tips for better results</h2>
    <ul>{p.tips.map((t) => <li>{t}</li>)}</ul>

    <h2>Common mistakes</h2>
    <ul>{p.mistakes.map((t) => <li>{t}</li>)}</ul>

    <h2>Frequently asked questions</h2>
    {p.faq.map(([q, a]) => <><h3>{q}</h3><p>{a}</p></>)}

    <h2>Is my image private?</h2>
    <p>Yes. Resizing and cropping happen in your browser using your own device. Your image is never uploaded to a server, so there is no account, watermark or limit.</p>

    <h2>Related tools</h2>
    <ul>
      {(p.links || []).map(([href, label]) => <li><a href={href}>{label}</a></li>)}
      {related.map((r) => <li><a href={`/${r.slug}`}>{r.h1}</a></li>)}
      <li><a href="/">All Sharesizer tools: resize, crop, compress, convert</a></li>
    </ul>
  </article>
</Base>
