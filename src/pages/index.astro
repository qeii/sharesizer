---
import Base from "../layouts/Base.astro";
import { TOOL_LIST } from "../data/tool-list.js";
import HomeClock from "../components/HomeClock.astro";
import SizeHub from "../components/SizeHub.astro";
---

<Base>
  <section class="hero">
    <h1>Free image tools for content creators</h1>
    <p>
      Resize, crop, compress, convert and check social media sizes. Everything
      runs in your browser, so your files never leave your device.
    </p>
  </section>

  <HomeClock />

  <nav class="tool-index" aria-label="All tools">
    {
      TOOL_LIST.map((t) => (
        <a class="ti-card" href={t.href}>
          <span class="ti-name">{t.name}</span>
          <span class="ti-short">{t.short} <b aria-hidden="true">→</b></span>
        </a>
      ))
    }
  </nav>

  <SizeHub />

  <section class="tool-about" aria-labelledby="about-h">
    <h2 id="about-h">What each tool does</h2>
    {
      TOOL_LIST.map((t) => (
        <article class="ta-item" id={t.id}>
          <div class="ta-head">
            <span class="ta-icon" aria-hidden="true">{t.icon}</span>
            <h3>{t.name}</h3>
          </div>
          <p set:html={t.long} />
          <ul>{t.points.map((p) => <li>{p}</li>)}</ul>
          <a class="ta-link" href={t.href}>Open {t.name} <b>→</b></a>
        </article>
      ))
    }
  </section>
</Base>

<style>
  .tool-index { max-width:1040px; margin:28px auto 0; display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:14px; }
  .ti-card { display:flex; flex-direction:column; gap:6px; padding:18px; border-radius:18px; border:1px solid var(--line); background:var(--panel); color:inherit; text-decoration:none; transition:transform .15s,border-color .15s,box-shadow .15s; }
  :global(:root[data-theme="light"]) .ti-card, :global(:root[data-theme="light"]) .ta-item { background:#fff; }
  .ti-card:hover, .ti-card:focus-visible { transform:translateY(-3px); border-color:var(--accent); box-shadow:var(--shadow); outline:none; }
  .ta-icon { display:inline-grid; place-items:center; width:38px; height:38px; border-radius:12px; font-size:18px; font-weight:800; color:#fff; background:linear-gradient(135deg,var(--accent),var(--accent-2)); }
  .ti-name { font-weight:700; font-size:1.05rem; color:var(--text); }
  .ti-short { font-size:14px; color:var(--muted); }
  .ti-short b { display:inline-block; color:var(--violet-text); font-weight:700; transition:transform .15s; }
  .ti-card:hover .ti-short b, .ti-card:focus-visible .ti-short b { transform:translateX(4px); }
  .tool-about { max-width:1040px; margin:56px auto 0; display:grid; grid-template-columns:repeat(auto-fit,minmax(300px,1fr)); gap:16px; }
  .tool-about > h2 { grid-column:1 / -1; font-size:1.5rem; letter-spacing:-.02em; margin:0 0 4px; }
  .ta-item { display:flex; flex-direction:column; padding:22px; border-radius:18px; border:1px solid var(--line); background:var(--panel); scroll-margin-top:90px; }
  .ta-head { display:flex; align-items:center; gap:12px; margin-bottom:10px; }
  .ta-head h3 { margin:0; font-size:1.15rem; }
  .ta-item p { margin:0 0 12px; color:var(--text-2); font-size:15px; }
  .ta-item p :global(a) { color:var(--violet-text); }
  .ta-item ul { margin:0 0 16px; padding-left:18px; color:var(--muted); font-size:14px; flex:1; }
  .ta-link { align-self:flex-start; font-weight:600; font-size:14px; color:var(--violet-text); text-decoration:none; }
  .ta-link:hover b { display:inline-block; transform:translateX(4px); }
</style>
