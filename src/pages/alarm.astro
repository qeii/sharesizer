---
import ClockPage from '../layouts/ClockPage.astro';
---
<ClockPage slug="alarm">
  <div id="stage" class="clock-stage">
    <div class="lcd lcd-time"><span id="t">--:--:--</span><span id="ap" class="lcd-ampm"></span></div>
    <div id="d" class="lcd-date"></div>
  </div>
  <div class="clock-panel card">
    <form id="af" class="alarm-form">
      <label>Time<input id="atime" type="time" required /></label>
      <label>Label (optional)<input id="alabel" type="text" maxlength="40" placeholder="Wake up" /></label>
      <label>Repeat<select id="arepeat"><option value="once">Once</option><option value="daily">Every day</option><option value="weekdays">Weekdays</option></select></label>
      <button class="btn" type="submit">Add alarm</button>
    </form>
    <ul id="alarms" class="alarm-list"></ul>
    <p class="clock-note">Alarms ring only while this tab is open, with your sound on.</p>
  </div>
  <div id="ring" class="ring" hidden role="alertdialog" aria-live="assertive" aria-label="Alarm">
    <div class="ring-box">
      <div id="ringT" class="lcd lcd-time"></div>
      <p id="ringL"></p>
      <button id="snooze" class="btn secondary" type="button">Snooze 5 min</button>
      <button id="stop" class="btn" type="button">Stop</button>
    </div>
  </div>
</ClockPage>
<script>import '../scripts/clock/alarm.js';</script>
